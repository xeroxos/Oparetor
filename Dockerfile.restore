# Restore the original React UID Operator + Flask API.
FROM node:22-bookworm-slim AS web-build
WORKDIR /app
ENV CI=true BASE_PATH=/ NODE_OPTIONS=--max-old-space-size=1536
RUN npm install -g pnpm@10.20.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY artifacts/uid-web ./artifacts/uid-web
COPY lib ./lib
RUN pnpm install --filter '@workspace/uid-web...' --no-frozen-lockfile --reporter=append-only --network-concurrency=4 > /tmp/pnpm-install.log 2>&1 || { tail -n 150 /tmp/pnpm-install.log; exit 1; }
RUN pnpm --filter @workspace/uid-web run typecheck
RUN pnpm --filter @workspace/uid-web run build

FROM python:3.12-slim AS app
WORKDIR /app
ENV PYTHONUNBUFFERED=1 STATIC_DIR=/app/static PORT=3000
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY artifacts/api-server/fb_server.py ./fb_server.py
RUN python -m py_compile ./fb_server.py
COPY --from=web-build /app/artifacts/uid-web/dist/public ./static
COPY tests/test_fb_server.py ./tests/test_fb_server.py
RUN python -m unittest discover -s tests -p 'test_fb_server.py' -v
EXPOSE 3000
CMD ["sh","-c","exec gunicorn --workers 1 --threads 8 --timeout 120 --bind 0.0.0.0:${PORT:-3000} fb_server:app"]
